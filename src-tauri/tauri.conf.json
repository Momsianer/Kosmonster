{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kosmonster",
  "version": "1.0.0",
  "identifier": "io.github.momsianer.kosmonster",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kosmonster",
        "width": 1280,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0b0d1a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SimulationGame",
    "shortDescription": "Weltraum Idle/Clicker Spiel",
    "longDescription": "Kosmonster ist ein Weltraum Idle/Clicker Spiel über das Sammeln mathematischer Sternmonster.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
